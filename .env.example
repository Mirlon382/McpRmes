# Copy to `.env` and edit. Every variable is optional: the values below are the shipped defaults.
# Lists are JSON, not comma-separated: ALLOWED_HOSTS=["a.example.com","b.example.com"].

# --- HTTP server -----------------------------------------------------------------------------------
# Interface and port uvicorn binds to.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Hostnames clients use to reach this server, checked against the Host header.
# ["*"] accepts any host, which disables the check: set this before exposing the server.
ALLOWED_HOSTS=["*"]

# Browser origins allowed to call the server. [] rejects every cross-origin browser request.
ALLOWED_ORIGINS=[]

# Peers whose X-Forwarded-For header is believed (addresses, CIDR or literals).
# Behind an ingress, list its pod network; widening this lets callers forge their own address.
TRUSTED_PROXY_HOSTS=["127.0.0.1"]

# --- RMES ------------------------------------------------------------------------------------------
# SPARQL endpoint and the namespace every named graph URI starts with.
RMES_SPARQL_ENDPOINT_URL=https://rdf.insee.fr/sparql
RMES_GRAPH_BASE_URI=http://rdf.insee.fr/graphes/

# Listing every graph counts triples across the whole store: its own budget and cache.
RMES_GRAPH_LISTING_TIMEOUT_SECONDS=45.0
RMES_GRAPH_LISTING_MAX_ROWS=1000
RMES_GRAPH_CACHE_TTL_SECONDS=3600.0

# describe_rmes_resource sends a fixed query the model cannot size: its own budget.
RMES_RESOURCE_QUERY_TIMEOUT_SECONDS=20.0
RMES_RESOURCE_QUERY_MAX_ROWS=2000

# --- run_rmes_sparql budgets -----------------------------------------------------------------------
# Published in the tool schema, so a change is visible to the model after a restart.
# Each default must stay within its maximum, or the server refuses to start.
RMES_QUERY_DEFAULT_TIMEOUT_SECONDS=20.0
RMES_QUERY_MAX_TIMEOUT_SECONDS=60.0
RMES_QUERY_DEFAULT_MAX_ROWS=200
RMES_QUERY_MAX_ROWS=2000

# --- Rate limiting ---------------------------------------------------------------------------------
# Requests per client address per window. Client identity comes from TRUSTED_PROXY_HOSTS.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# --- Logging ---------------------------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Identity --------------------------------------------------------------------------------------
# Server name and instructions sent in the MCP handshake.
SERVER_NAME=INSEE-mcp-server
# INSTRUCTIONS= free-text block sent with the handshake; the shipped default is one line
# saying RMeS holds metadata and no figures. Multi-line values are awkward in .env,
# so set it in code or as a quoted value if you need more.
